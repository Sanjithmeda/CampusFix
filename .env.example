# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional OpenAI API key or free OpenAI-compatible API key.
# Users can also configure this dynamically from the in-app AI Settings dialog.
OPENAI_API_KEY="sk-..."

# OPENAI_BASE_URL: Base URL for OpenAI API or free compatible endpoints (e.g., OpenRouter, Groq).
# Defaults to https://api.openai.com/v1
OPENAI_BASE_URL="https://api.openai.com/v1"

# OPENAI_MODEL: Model identifier (e.g., gpt-4o-mini, gpt-4o, gpt-3.5-turbo).
OPENAI_MODEL="gpt-4o-mini"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

