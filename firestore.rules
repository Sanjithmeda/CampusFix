rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Connection test health check
    match /test/{docId} {
      allow read, write: if true;
    }

    // 1. User Profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // 2. Admins collection
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // 3. Complaints - Full read and persistence
    match /complaints/{complaintId} {
      allow read, write: if true;

      // Complaint Activity Audit Logs
      match /history/{activityId} {
        allow read, create: if true;
        allow update, delete: if false;
      }
    }

    // 4. Maintenance Announcements
    match /announcements/{announcementId} {
      allow read, write: if true;
    }

    // 5. Campus Areas
    match /campus_areas/{areaId} {
      allow read, write: if true;
    }

    // 6. Categories
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // 7. Maintenance Teams
    match /maintenance_teams/{teamId} {
      allow read, write: if true;
    }

    // 8. Notifications
    match /notifications/{notificationId} {
      allow read, write: if true;
    }
  }
}
